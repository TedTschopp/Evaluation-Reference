{
  "$defs": {
    "AgentAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 30000,
          "title": "Text",
          "type": "string"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Citations",
          "type": "array"
        },
        "disposition": {
          "default": "answer",
          "enum": [
            "answer",
            "clarify",
            "insufficient_evidence"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        }
      },
      "required": [
        "text"
      ],
      "title": "AgentAnswer",
      "type": "object"
    },
    "Authentication": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "none",
          "enum": [
            "none",
            "bearer"
          ],
          "title": "Type",
          "type": "string"
        },
        "environment_variable": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Variable"
        }
      },
      "title": "Authentication",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "streaming": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Streaming"
        }
      },
      "title": "Capabilities",
      "type": "object"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "repetition": {
          "default": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "authored_fixture",
            "captured_model_run"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "answer": {
          "$ref": "#/$defs/AgentAnswer"
        },
        "events": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Events",
          "type": "array"
        },
        "messages": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Messages",
          "type": "array"
        },
        "grades": {
          "items": {
            "$ref": "#/$defs/Grade"
          },
          "title": "Grades",
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "error",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "tokens": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "framework": {
          "additionalProperties": true,
          "title": "Framework",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "case_id",
        "profile",
        "source_kind",
        "answer",
        "status",
        "critical"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "GenerationOptions": {
      "additionalProperties": false,
      "properties": {
        "json_schema": {
          "default": false,
          "title": "Json Schema",
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Temperature"
        },
        "max_output_tokens": {
          "default": 1200,
          "maximum": 4096,
          "minimum": 64,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "maximum": 120,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "GenerationOptions",
      "type": "object"
    },
    "Grade": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "ai_judge",
            "weak_checker",
            "reference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "error",
            "not_assessed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "label",
        "kind",
        "status",
        "reason"
      ],
      "title": "Grade",
      "type": "object"
    },
    "ModelEndpointDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "default": "my-endpoint",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "My model",
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "protocol": {
          "default": "openai_chat_completions",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Protocol",
          "type": "string"
        },
        "base_url": {
          "maxLength": 2048,
          "minLength": 8,
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "authentication": {
          "$ref": "#/$defs/Authentication"
        },
        "generation": {
          "$ref": "#/$defs/GenerationOptions"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        }
      },
      "required": [
        "base_url",
        "model"
      ],
      "title": "ModelEndpointDefinition",
      "type": "object"
    },
    "ReleaseDecision": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "hold",
            "eligible"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "critical_failures": {
          "title": "Critical Failures",
          "type": "integer"
        },
        "unresolved": {
          "title": "Unresolved",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ReleasePolicy"
        }
      },
      "required": [
        "verdict",
        "passed",
        "total",
        "pass_rate",
        "critical_failures",
        "unresolved",
        "reasons",
        "policy"
      ],
      "title": "ReleaseDecision",
      "type": "object"
    },
    "ReleasePolicy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "teaching-default-v1",
          "title": "Id",
          "type": "string"
        },
        "minimum_pass_rate": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Pass Rate",
          "type": "number"
        },
        "maximum_critical_failures": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Maximum Critical Failures",
          "type": "integer"
        },
        "require_complete": {
          "default": true,
          "title": "Require Complete",
          "type": "boolean"
        }
      },
      "title": "ReleasePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "provenance": {
      "title": "Provenance",
      "type": "string"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelEndpointDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "judge_endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelEndpointDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_results": {
      "minimum": 0,
      "title": "Expected Results",
      "type": "integer"
    },
    "judge_calibration": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Judge Calibration",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Results",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ReleaseDecision"
    }
  },
  "required": [
    "id",
    "created_at",
    "mode",
    "provenance",
    "versions",
    "expected_results",
    "results",
    "decision"
  ],
  "title": "RunBundle",
  "type": "object"
}
