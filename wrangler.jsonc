{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"founding-eval-lab",
 "account_id":"13ebf849f1787412dc2c48a262de0407",
 "main":"worker/index.ts",
 "compatibility_date":"2026-11-02",
